{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Hardhat: CurrentFile",
            "program": "${workspaceFolder}/node_modules/.bin/hardhat",
            "args": [
                "test",
                "${file}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Hardhat: AllFile",
            "program": "${workspaceFolder}/node_modules/.bin/hardhat",
            "args": [
                "test"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Hardhat: SpecifyFile",
            "program": "${workspaceFolder}/node_modules/.bin/hardhat",
            "args": [
                "test",
                "--grep",
                "应该验证输出代币数量是否达到最小要求"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}